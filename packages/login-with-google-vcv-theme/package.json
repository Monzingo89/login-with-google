{
  "name": "login-with-google-vcv-theme",
  "version": "0.1.0",
  "description": "Black and gold VCV theme for the login-with-google package.",
  "type": "module",
  "sideEffects": [
    "./theme.css"
  ],
  "style": "./theme.css",
  "exports": {
    ".": "./theme.css",
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "theme.css",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"import('node:fs').then(({accessSync})=>accessSync('theme.css'))\"",
    "test": "node -e \"import('node:fs').then(({readFileSync})=>{const css=readFileSync('theme.css','utf8');if(!css.includes('.lwg-page'))process.exit(1)})\""
  },
  "keywords": [
    "firebase",
    "login",
    "theme",
    "css",
    "vcv"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "login-with-google": ">=0.1.0 <1"
  }
}
